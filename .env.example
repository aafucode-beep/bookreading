DOMAIN=books.example.com

ENVIRONMENT=production
SECRET_KEY=replace-with-at-least-48-random-characters
PUBLIC_BASE_URL=https://books.example.com
DATABASE_URL=sqlite:///data/brave_growth.db
DATA_DIR=data
MEDIA_DIR=data/media
APK_VERSION=0.1.0
APK_DOWNLOAD_URL=/downloads/brave-growth.apk

# mock 仅供本地验收；VPS 改为 live。
AI_MODE=live
PREFERRED_PROVIDER=minimax
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_CONCURRENCY=2

# MiniMax CN Token Plan
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_CHAT_URL=https://api.minimaxi.com/v1/chat/completions
MINIMAX_TTS_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_VOICE_ID=male-qn-qingse
MINIMAX_MCP_COMMAND=uvx
MINIMAX_MCP_ARGS=minimax-coding-plan-mcp,-y

# MiniMax 不可用时自动回退
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral

